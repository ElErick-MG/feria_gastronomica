# Variables de entorno — Feria Gastronómica
# ─────────────────────────────────────────
# ESTE ARCHIVO ES SOLO UN EJEMPLO. NO ALMACENES VALORES REALES AQUÍ.
# Copia este archivo como .env.local para desarrollo local (nunca lo subas a git).
#
# Para Vercel: configura estas variables desde el dashboard
# → Settings → Environment Variables → Production / Preview / Development

# ── Firebase Realtime Database ──────────────────────────────────
# Estas variables son inyectadas en tiempo de build si usas un bundler (Vite, etc.)
# Para este proyecto estático, los valores van directamente en js/firebase.js
# (ver nota de seguridad en ese archivo — la config Firebase es pública por diseño).

FIREBASE_API_KEY=TU_API_KEY
FIREBASE_AUTH_DOMAIN=TU_PROYECTO.firebaseapp.com
FIREBASE_DATABASE_URL=https://TU_PROYECTO-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=TU_PROYECTO
FIREBASE_APP_ID=TU_APP_ID
